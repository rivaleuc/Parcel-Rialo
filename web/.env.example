# Copy to .env.local and fill in. Every value is optional for local dev:
# without them the app runs with an in-memory store and a local dev identity.

# --- Auth (Privy) ---
# Get these from https://dashboard.privy.io after creating an app.
# Client-side app id (safe to expose):
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-side credentials for verifying access tokens:
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Database ---
# When set, escrows persist in Postgres. When empty, an in-memory store is used.
DATABASE_URL=

# --- Carrier ---
# Override the base URL the server uses to poll the carrier. Defaults to the
# deployment's own /api/mock-carrier. Set UPS_API_KEY to enable the UPS sandbox.
CARRIER_BASE_URL=
UPS_API_KEY=
